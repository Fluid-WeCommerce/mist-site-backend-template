# Site backend template: example environment.
# Fluid sets these on the Vercel project when it creates this site's backend.
# You only need them locally for `npm run dev`.

# Neon Postgres connection string. Not used by `npm run dev` (PGlite, in memory).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# HMAC-SHA256 secret that Fluid signs every request with.
FLUID_SIGNING_SECRET=whsec_replace_me

# Non-secret ids of the one site and company this copy serves.
FLUID_SITE_ID=00000000-0000-7000-8000-000000000000
FLUID_COMPANY_ID=1
